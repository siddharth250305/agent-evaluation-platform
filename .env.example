# Copy to .env (git-ignored) and fill in. Nothing loads this file automatically;
# export it into your shell before paid commands:  set -a; source .env; set +a

# Required only by the paid commands (make evaluate / make bfcl / make judge), and only
# the key for the vendor of the model you select: claude-* models vs gpt-* models
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional; defaults to the docker compose database
# DATABASE_URL=postgresql+psycopg://eval:eval_local_only@127.0.0.1:5432/agent_eval
